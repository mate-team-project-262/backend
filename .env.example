# MySQL Database Configuration (Template)
MYSQL_HOST=localhost
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_PORT=3306
# Offline demo is the default; set TITLE_SOURCE=tmdb and a TMDB API Read Access Token for live data.
TITLE_SOURCE=stub
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_CONNECT_TIMEOUT=3s
TMDB_READ_TIMEOUT=5s
TMDB_LANGUAGE=en-US
TMDB_CERTIFICATION_COUNTRY=US
TMDB_MAX_RESPONSE_BYTES=4194304

# Internal room-deck preparation limits (single application instance).
DECK_MAX_PAGE_WINDOW=50
DECK_INITIAL_PAGE_COUNT=4
DECK_MAX_DISCOVER_REQUESTS=8
DECK_MAX_DETAILS_REQUESTS=30
DECK_BUILD_TIMEOUT=60s
